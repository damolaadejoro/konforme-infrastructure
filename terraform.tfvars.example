# ============================================================================
# Terraform Variables — copy to terraform/terraform.tfvars for local use (never commit)
# ============================================================================
#
# In GitHub Actions the same values come from the "production" environment's
# variables and secrets as TF_VAR_<NAME> (see README.md → Prerequisites).
#
# secret_key, encryption_key and postgres_password must be the values already
# in production: encryption_key decrypts stored customer cloud credentials.
#
#   secret_key        — python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#   encryption_key    — python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   postgres_password — python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# ============================================================================

aws_region    = "eu-west-1"
project_name  = "konforme"
domain_name   = "konforme.io"
api_subdomain = "api"
instance_type = "t3.small"

ssh_key_name        = "konforme-ec2"
admin_cidr_blocks   = ["YOUR_IP/32"]
konforme_aws_account_id = "123456789012"

secret_key        = "GENERATE_ME_MIN_32_CHARS"
encryption_key    = "GENERATE_ME_FERNET_KEY"
postgres_password = "GENERATE_ME"

allowed_origins    = "https://app.konforme.io"
budget_alert_email = "your-email@example.com"

# --- Serverless stack ---
lambda_image_tag  = "bootstrap-1"       # first image pushed by hand; CI deploys after that
cutover_to_lambda = false               # true once the data migration is done
resend_api_key    = "re_..."            # without it no emails are sent
# dynamodb_table_name = "konforme"
